defaults:
  timeout_seconds: 180
  max_retries: 3
  retry_base_seconds: 30

# Directory aliases for server-side file transport (replacement_files / files).
# Each alias names exactly one directory. A request references a file as
# 'alias/relative/path'; the server resolves it against that directory and reads
# it itself. Empty/absent disables the feature (fail closed).
directory_aliases:
  # job_applications: C:\path\to\your\documents
  # reference_docs: C:\path\to\your\reference\documents

providers:
  chatgpt:
    type: openai
    api_key_env_var: OPENAI_API_KEY
    models:
      low:
        model: gpt-4.1-mini
        temperature: 0.2
        max_tokens: 16000
      middle:
        model: gpt-4.1
        temperature: 0.2
        max_tokens: 32000
      high:
        model: gpt-5.5
        max_completion_tokens: 48000

  gemini:
    type: gemini
    api_key_env_var: GEMINI_API_KEY
    models:
      low:
        model: gemini-3.1-flash-lite
        temperature: 0.2
        max_output_tokens: 16000
      middle:
        model: gemini-3.5-flash
        temperature: 0.2
        max_output_tokens: 32000
      high:
        model: gemini-2.5-pro
        temperature: 0.1
        max_output_tokens: 48000

  claude:
    type: anthropic
    api_key_env_var: ANTHROPIC_API_KEY
    models:
      low:
        model: claude-haiku-4-5
        temperature: 0.2
        max_tokens: 16000
      middle:
        model: claude-sonnet-4-6
        temperature: 0.2
        max_tokens: 32000
      high:
        model: claude-opus-4-8
        temperature: 0.1
        max_tokens: 48000
