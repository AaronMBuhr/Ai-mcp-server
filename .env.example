# Copy to .env in this directory and fill in values.
# Keys are read when ai-mcp-server starts (including via Claude Code MCP).

# --- LLM provider keys (names must match ai-mcp-server.yaml) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# NOT used by this server (use GEMINI_API_KEY instead):
# GOOGLE_API_KEY=

# --- Optional MCP server settings (MCP_ prefix) ---
# MCP_TRANSPORT=stdio
# MCP_CONFIG_PATH=ai-mcp-server.yaml
# MCP_PROMPT_DIR=prompts
